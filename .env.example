# Example environment configuration for the multi-DEX funding bot
# Copy to `.env` and replace the placeholder values with your own.

# AsterDex API credentials
# Public API key issued by AsterDex for REST access
ASTERDEX_API_KEY=your_asterdex_api_key
# Secret key paired with the API key (keep private!)
ASTERDEX_API_SECRET=your_asterdex_api_secret

# Core trading parameters
# Default DEX adapter to load (e.g. asterdex, future hyperliquid)
FUNDING_DEX=asterdex
# Total notional capital (in USDT) the bot should deploy per run
FUNDING_CAPITAL=100
# Quote amount (USDT) to submit per batch order
FUNDING_BATCH_QUOTE=10
# Strategy direction (buy_spot_short_futures or sell_spot_long_futures)
FUNDING_MODE=buy_spot_short_futures

# Monitoring & logging
# Interval (seconds) between background monitor refreshes
FUNDING_MONITOR_INTERVAL=60
# Verbosity for server logs (DEBUG/INFO/WARNING/ERROR)
FUNDING_LOG_LEVEL=INFO
